# ====================================================================
# MASTER ROUTING SWITCH (Change these variables to switch models)
# ====================================================================
# Options: "openai" | "gemini" | "open_cloud"
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o

# Alternative Configuration Examples for User Reference:
# For Gemini:     LLM_PROVIDER=gemini      | LLM_MODEL_NAME=gemini-1.5-pro
# For Open Cloud: LLM_PROVIDER=open_cloud  | LLM_MODEL_NAME=claude-3-5-sonnet

# ====================================================================
# PRIVATE SECURITY CREDS (Populate your active credentials)
# ====================================================================
# Local App & Execution Engine Access
ALPACA_API_KEY=your_actual_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_actual_alpaca_secret_here
ALPACA_IS_PAPER=true

# Model Providers (Keep your keys loaded safely simultaneously)
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
OPEN_CLOUD_API_KEY=your_anthropic_claude_key_here

# ====================================================================
# 🛡️ DETERMINISTIC COMPLIANCE RISK BOUNDARIES
# ====================================================================
MAX_PORTFOLIO_RISK_PERCENT=0.05
MAX_LEG_COUNT=4
