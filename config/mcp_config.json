{
  "mcpServers": {
    "alpaca-options-server": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp-server-alpaca",
        "mcp-server-alpaca"
      ],
      "env": {
        "ALPACA_API_KEY": "your_actual_alpaca_paper_key_here",
        "ALPACA_SECRET_KEY": "your_actual_alpaca_secret_here",
        "ALPACA_USE_PAPER": "true"
      }
    }
  }
}
